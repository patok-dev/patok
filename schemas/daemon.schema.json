{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DaemonSettings",
  "description": "The merged, normalized daemon settings. Every field here is read by the engine\nor shell; add a field only together with its consumer.",
  "type": "object",
  "properties": {
    "adaptive_pauses": {
      "type": "boolean"
    },
    "agent_timeout_secs": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "auto_push_enabled": {
      "type": "boolean"
    },
    "auto_push_remote": {
      "type": "string"
    },
    "batch_review": {
      "type": "boolean"
    },
    "builder_model": {
      "type": "string"
    },
    "builder_provider": {
      "$ref": "#/$defs/ProviderName"
    },
    "confidence_threshold": {
      "type": "number",
      "format": "double"
    },
    "discovery_cooldown_cap_secs": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "discovery_cooldown_secs": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "discovery_model": {
      "type": "string"
    },
    "discovery_provider": {
      "$ref": "#/$defs/ProviderName"
    },
    "engine_idle_timeout_secs": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "history_dir": {
      "type": [
        "string",
        "null"
      ]
    },
    "history_retention_days": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "history_retention_tasks": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "orchestrator_model": {
      "type": "string"
    },
    "orchestrator_provider": {
      "$ref": "#/$defs/ProviderName"
    },
    "pause_between_agents_secs": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "pause_between_cycles_secs": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "pause_between_tasks_secs": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "plan_enabled": {
      "description": "Whether a plan session runs before each builder session (T10.1).",
      "type": "boolean"
    },
    "planner_model": {
      "type": "string"
    },
    "planner_provider": {
      "$ref": "#/$defs/ProviderName"
    },
    "research_model": {
      "type": "string"
    },
    "research_provider": {
      "$ref": "#/$defs/ProviderName"
    },
    "review_confidence_threshold": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "review_in_loop": {
      "type": "boolean"
    },
    "review_multipass_threshold": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "reviewer_model": {
      "type": "string"
    },
    "reviewer_provider": {
      "$ref": "#/$defs/ProviderName"
    },
    "run_mode": {
      "$ref": "#/$defs/RunMode"
    },
    "skip_research_for_simple": {
      "description": "Whether a Simple-classified task skips the research stage (T68.1).",
      "type": "boolean"
    },
    "skip_review_for_simple": {
      "type": "boolean"
    },
    "stages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Stage"
      }
    }
  },
  "required": [
    "research_model",
    "planner_model",
    "builder_model",
    "reviewer_model",
    "discovery_model",
    "orchestrator_model",
    "research_provider",
    "planner_provider",
    "builder_provider",
    "reviewer_provider",
    "discovery_provider",
    "orchestrator_provider",
    "run_mode",
    "stages",
    "skip_research_for_simple",
    "skip_review_for_simple",
    "review_confidence_threshold",
    "batch_review",
    "review_in_loop",
    "review_multipass_threshold",
    "confidence_threshold",
    "auto_push_enabled",
    "auto_push_remote",
    "discovery_cooldown_secs",
    "discovery_cooldown_cap_secs",
    "plan_enabled",
    "agent_timeout_secs",
    "pause_between_tasks_secs",
    "pause_between_agents_secs",
    "pause_between_cycles_secs",
    "adaptive_pauses",
    "engine_idle_timeout_secs",
    "history_retention_tasks",
    "history_retention_days"
  ],
  "$defs": {
    "ProviderName": {
      "description": "A provider name as written in config files:\ntrimmed, case-insensitive, aliases accepted.",
      "type": "string",
      "enum": [
        "claude",
        "codex",
        "mistral"
      ]
    },
    "RunMode": {
      "description": "The run mode.",
      "type": "string",
      "enum": [
        "sprint",
        "continuous"
      ]
    },
    "Stage": {
      "description": "One pipeline stage: id, label, enabled flag and an optional\nprompt override. A stage absent from the list is treated as disabled by the consumer;\norder is display-only.",
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "id": {
          "$ref": "#/$defs/StageId"
        },
        "label": {
          "type": "string"
        },
        "prompt": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "label",
        "enabled"
      ]
    },
    "StageId": {
      "description": "A stage id as written in a `[[daemon.stages]]` entry: the four pipeline\nstage spellings plus `implement`, the build stage's pre-enum spelling.",
      "type": "string",
      "enum": [
        "research",
        "plan",
        "build",
        "implement",
        "review"
      ]
    }
  }
}